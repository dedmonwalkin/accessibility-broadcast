# Server
PORT=3000
NODE_ENV=development

# Auth
# - Comma-separated standard API keys. REQUIRED in production. Blank values
#   fail-closed in NODE_ENV=production unless AUTH_DISABLED=true is set
#   explicitly. Use strong random values (>= 32 bytes, e.g. from `openssl rand -hex 32`).
API_KEYS=
# - Keys in ADMIN_API_KEYS additionally pass admin-scope checks for
#   /v1/admin/* and /v1/debug/* endpoints.
ADMIN_API_KEYS=
# - Pepper applied before hashing keys in memory. Set to a persistent secret.
API_KEY_PEPPER=
# - Explicit opt-out for local dev only. DO NOT set this in production.
AUTH_DISABLED=false

# Trusted proxy addresses (comma-separated IPs). X-Forwarded-For is only
# honored when the immediate peer address is in this list.
TRUSTED_PROXIES=

# Debug / admin endpoints
# - /v1/debug/state is gated behind DEBUG_ENDPOINTS=true AND admin scope.
DEBUG_ENDPOINTS=false
# - If true, SSE stream endpoint is publicly readable (use-case: public
#   broadcasts). Default requires API-key auth like any other endpoint.
SSE_PUBLIC_STREAMS=false

# Postgres persistence
ENABLE_POSTGRES=false
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/accessibility_broadcast
# One of: disable / allow / prefer / require / verify-ca / verify-full
# Defaults to "require" in production, "prefer" otherwise.
DATABASE_SSL=prefer

# Auto-snapshot interval in ms (default: 5 minutes)
SNAPSHOT_INTERVAL_MS=300000

# In-memory retention / cleanup. The server periodically sweeps
# stopped streams, resolved incidents, old feedback, and expired
# ad sessions to keep memory bounded.
CLEANUP_INTERVAL_MS=3600000
RETAIN_STOPPED_STREAMS_MS=86400000
RETAIN_RESOLVED_INCIDENTS_MS=604800000
RETAIN_FEEDBACK_MS=2592000000
RETAIN_AD_SESSIONS_MS=86400000
AUDIT_LOG_MAX_ENTRIES=10000

# Rate limiting — requests per minute per IP (0 = disabled)
RATE_LIMIT_RPM=60

# Body-size caps (bytes). Reject with 413 when exceeded.
MAX_JSON_BODY_BYTES=1048576
MAX_INGEST_BODY_BYTES=16777216

# Outbound egress hardening
# - Set to "true" to allow http:// outbound (default: false in production).
OUTBOUND_ALLOW_INSECURE=false
# - Set to "true" to allow RFC1918/loopback/link-local outbound hosts
#   (useful for self-hosted LibreTranslate in the same cluster).
OUTBOUND_ALLOW_PRIVATE_HOSTS=false
# - Optional comma-separated allowlist of outbound hostnames.
MODEL_PROVIDER_ALLOWED_HOSTS=

# Model provider: "mock" (default, no gateway needed) or "http"
# "http" enables real Whisper transcription via POST /v1/streams/:id/ingest/chunk
# Point MODEL_HTTP_BASE_URL at a real Whisper gateway or the included stub.
# Validated at boot: must be https:// in production unless explicitly allowed.
MODEL_PROVIDER=mock
MODEL_HTTP_BASE_URL=http://localhost:4011

# Translation provider: "mock" (default) / "libretranslate" / "deepl"
TRANSLATION_PROVIDER=mock
# LibreTranslate (self-hosted): set base URL, optional API key
TRANSLATION_HTTP_BASE_URL=http://localhost:5000
TRANSLATION_API_KEY=
# DeepL Free: set TRANSLATION_PROVIDER=deepl and supply your auth key
# TRANSLATION_API_KEY=your-deepl-auth-key-here
